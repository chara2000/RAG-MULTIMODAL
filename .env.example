# ═══════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — Copia como .env y rellena los valores
# ═══════════════════════════════════════════════════════════

# ── Ambiente y Debug ───────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...tu-clave-aqui...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Proveedor LLM: "openai" o "ollama" ────────────────────
LLM_PROVIDER=openai

# ── Ollama (modelo local gratis, alternativa a OpenAI) ────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Qdrant (se autoconecta al contenedor Docker) ──────────
# En Docker, el nombre del servicio "qdrant" actúa como hostname
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Almacenamiento de PDFs e imágenes ────────────────────
# En Docker: el volumen storage_data se monta en /app/storage
# En local:  usa la carpeta ./storage relativa al proyecto
STORAGE_DIR=/app/storage

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
